# Копия для локального запуска: cp .env.example .env, затем впишите свои ключи.
# Файл .env не должен попадать в git — он уже в .gitignore.

# Приоритет провайдера LLM в app/llm_client.py: Yandex Cloud -> Anthropic -> эвристика-заглушка.
# Ни один ключ не задан — используется эвристика по ключевым словам (см. plan.md, п.8).

# Yandex Cloud (OpenAI-совместимый API, foundation models)
# Проверить ключ по-настоящему: GET /api/llm/status (или кнопка "Проверить
# ключ" в API-панели оператора) — делает реальный запрос, а не просто
# смотрит, задана ли переменная.
#
# Частая ошибка: 403 "Permission EXEC denied. You need the
# ai.assistants.editor, editor, or admin role in the folder in question."
# Это не проблема кода и не путаницы с YANDEX_CLOUD_FOLDER — ключ жёстко
# привязан к одному сервисному аккаунту, folder только говорит, чьими
# ресурсами пользоваться. Смена folder тут не поможет, скорее всего
# просто сменит ошибку на "нет доступа к этой папке вообще". Чинится в
# Yandex Cloud Console -> IAM -> Service accounts -> найти аккаунт этого
# ключа -> Roles -> добавить ai.assistants.editor (или editor/admin) на
# нужную папку.
YANDEX_API_KEY=
YANDEX_CLOUD_FOLDER=b1gcckd2llp6t0dj6j6e
YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest

# Anthropic Claude (используется, если YANDEX_API_KEY не задан)
ANTHROPIC_API_KEY=

# База данных бэкенда
DATABASE_URL=sqlite:///./app.db
